{
  "name": "@knowledgeassemble/interactive-engine",
  "version": "0.1.2",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "dependencies": {
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@knowledgeassemble/timeline-engine": "workspace:*",
    "@knowledgeassemble/visual-engine": "workspace:*",
    "ajv": "^8.20.0",
    "@knowledgeassemble/diagram-engine": "workspace:*"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "pretypecheck": "pnpm build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src test",
    "test": "vitest run",
    "playwright": "playwright test",
    "prepublishOnly": "pnpm build && pnpm typecheck && pnpm lint && pnpm test"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "src",
    "dist"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  }
}
