{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knowledgeassemble.com/schemas/geomap-spec.schema.json",
  "title": "GeoMap Engine Specification",
  "description": "Schema for @knowledgeassemble/geomap-engine specifications (P4 slice).",
  "type": "object",
  "required": [
    "type",
    "version",
    "id",
    "sources"
  ],
  "additionalProperties": false,
  "properties": {
    "type": {
      "const": "geomap"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z][a-zA-Z0-9._-]*$",
      "maxLength": 128
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "author": {
          "type": "string"
        }
      }
    },
    "purpose": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "learningObjective": {
          "type": "string"
        },
        "reasoningMode": {
          "type": "string"
        }
      },
      "required": [
        "learningObjective"
      ]
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "viewport": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "fit": {
              "const": "content"
            },
            "padding": {
              "type": "number",
              "minimum": 0,
              "maximum": 0.5
            },
            "center": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "lat": {
                  "type": "number",
                  "minimum": -90,
                  "maximum": 90
                },
                "lon": {
                  "type": "number",
                  "minimum": -180,
                  "maximum": 180
                }
              },
              "required": [
                "lat",
                "lon"
              ]
            },
            "zoom": {
              "type": "number",
              "minimum": 0,
              "maximum": 20
            }
          }
        },
        "projection": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "equirectangular",
                "mercator",
                "albers"
              ]
            }
          },
          "required": [
            "type"
          ]
        },
        "scaleBar": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "visible": {
              "type": "boolean"
            },
            "unit": {
              "type": "string",
              "enum": [
                "km",
                "mi"
              ]
            }
          }
        },
        "compass": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "referenceEntityId",
            "window"
          ],
          "properties": {
            "referenceEntityId": {
              "type": "string",
              "pattern": "^[a-zA-Z][a-zA-Z0-9._-]*$"
            },
            "window": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "label",
                "from",
                "to"
              ],
              "properties": {
                "label": {
                  "type": "string",
                  "minLength": 1
                },
                "from": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 360
                },
                "to": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 360
                }
              }
            }
          }
        },
        "geography": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "sources": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[a-zA-Z][a-zA-Z0-9._-]*$"
                  },
                  "type": {
                    "const": "geojson"
                  },
                  "class": {
                    "type": "string",
                    "enum": [
                      "authoritative",
                      "illustrative",
                      "simulated"
                    ]
                  },
                  "data": {
                    "type": "object"
                  },
                  "uri": {
                    "type": "string"
                  }
                },
                "required": [
                  "id",
                  "type",
                  "class"
                ],
                "anyOf": [
                  {
                    "required": [
                      "data"
                    ]
                  },
                  {
                    "required": [
                      "uri"
                    ]
                  }
                ]
              }
            }
          },
          "required": [
            "sources"
          ]
        },
        "entities": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-zA-Z][a-zA-Z0-9._-]*$"
              },
              "type": {
                "type": "string",
                "enum": [
                  "country",
                  "state",
                  "province",
                  "region",
                  "city",
                  "town",
                  "village",
                  "river",
                  "lake",
                  "mountain",
                  "landmark",
                  "place"
                ]
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string"
              },
              "location": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "source": {
                    "type": "string"
                  },
                  "featureId": {
                    "type": "string"
                  },
                  "coordinates": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "lat": {
                        "type": "number",
                        "minimum": -90,
                        "maximum": 90
                      },
                      "lon": {
                        "type": "number",
                        "minimum": -180,
                        "maximum": 180
                      }
                    },
                    "required": [
                      "lat",
                      "lon"
                    ]
                  }
                },
                "anyOf": [
                  {
                    "required": [
                      "source",
                      "featureId"
                    ]
                  },
                  {
                    "required": [
                      "coordinates"
                    ]
                  }
                ]
              },
              "links": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "categories": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "adjacentTo": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "id",
              "type",
              "name",
              "location"
            ]
          }
        },
        "layers": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-zA-Z][a-zA-Z0-9._-]*$"
              },
              "type": {
                "type": "string",
                "enum": [
                  "region",
                  "marker",
                  "route",
                  "label"
                ]
              },
              "title": {
                "type": "string"
              },
              "visible": {
                "type": "boolean"
              },
              "style": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "role": {
                    "type": "string",
                    "enum": [
                      "primary-region",
                      "secondary-region",
                      "marker",
                      "route",
                      "label",
                      "highlight",
                      "selected",
                      "approximate"
                    ]
                  }
                }
              },
              "encoding": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "attribute": {
                    "type": "string"
                  },
                  "type": {
                    "type": "string",
                    "enum": [
                      "fill",
                      "size"
                    ]
                  },
                  "breakpoints": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "array",
                      "minItems": 2,
                      "maxItems": 2,
                      "items": {
                        "type": "number"
                      }
                    }
                  }
                },
                "required": [
                  "attribute",
                  "type",
                  "breakpoints"
                ]
              },
              "items": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "entity": {
                      "type": "string"
                    },
                    "label": {
                      "type": "boolean"
                    },
                    "interactive": {
                      "type": "boolean"
                    },
                    "id": {
                      "type": "string",
                      "pattern": "^[a-zA-Z][a-zA-Z0-9._-]*$"
                    },
                    "path": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "minItems": 2
                    },
                    "measure": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "attribute": {
                          "type": "string"
                        },
                        "value": {
                          "type": "number"
                        }
                      },
                      "required": [
                        "attribute",
                        "value"
                      ]
                    }
                  },
                  "anyOf": [
                    {
                      "required": [
                        "entity"
                      ]
                    },
                    {
                      "required": [
                        "id",
                        "path"
                      ]
                    }
                  ]
                }
              }
            },
            "required": [
              "id",
              "type",
              "items"
            ]
          }
        },
        "legend": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "visible": {
              "type": "boolean"
            },
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "role": {
                    "type": "string",
                    "minLength": 1
                  },
                  "label": {
                    "type": "string",
                    "minLength": 1
                  },
                  "linkedEntities": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "interactive": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "role",
                  "label"
                ]
              }
            }
          }
        },
        "periods": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "label",
              "from",
              "to",
              "sources",
              "regionEntityIds"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-zA-Z][a-zA-Z0-9._-]*$"
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "from": {
                "type": "string"
              },
              "to": {
                "type": "string"
              },
              "sources": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "class": {
                      "type": "string",
                      "enum": [
                        "authoritative",
                        "illustrative",
                        "simulated"
                      ]
                    },
                    "title": {
                      "type": "string"
                    },
                    "citation": {
                      "type": "string"
                    },
                    "url": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "class"
                  ]
                }
              },
              "regionEntityIds": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "interaction": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "type": "string"
        },
        "actions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "questions": {
      "type": "array"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "class": {
            "type": "string",
            "enum": [
              "authoritative",
              "illustrative",
              "simulated"
            ]
          }
        },
        "required": [
          "class"
        ]
      }
    },
    "accessibility": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "label": {
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      }
    }
  },
  "$defs": {}
}
