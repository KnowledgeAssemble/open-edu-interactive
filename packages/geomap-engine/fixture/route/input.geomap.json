{
  "type": "geomap",
  "version": "1.0.0",
  "id": "route-only",
  "metadata": { "title": "Route only" },
  "purpose": { "learningObjective": "Trace a route" },
  "content": {
    "projection": { "type": "equirectangular" },
    "geography": {
      "sources": [{ "id": "src", "type": "geojson", "class": "illustrative", "data": { "type": "FeatureCollection", "features": [] } }]
    },
    "entities": [
      { "id": "a", "type": "city", "name": "City A", "location": { "coordinates": { "lat": 10, "lon": 20 } } },
      { "id": "b", "type": "city", "name": "City B", "location": { "coordinates": { "lat": 11, "lon": 21 } } },
      { "id": "c", "type": "city", "name": "City C", "location": { "coordinates": { "lat": 12, "lon": 22 } } }
    ],
    "layers": [
      { "id": "route-layer", "type": "route", "items": [{ "id": "my-route", "path": ["a", "b", "c"] }] },
      { "id": "markers", "type": "marker", "items": [{ "entity": "a", "interactive": true }, { "entity": "b", "interactive": true }, { "entity": "c", "interactive": true }] }
    ]
  },
  "interaction": { "mode": "explore", "actions": ["select", "deselect", "focus"] },
  "questions": [],
  "sources": [{ "class": "illustrative" }],
  "accessibility": { "label": "Route only map" }
}