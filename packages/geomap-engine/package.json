{
  "name": "@knowledgeassemble/geomap-engine",
  "version": "0.1.0",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "dependencies": {
    "@knowledgeassemble/interactive-engine": "workspace:*",
    "@knowledgeassemble/svg-kit": "workspace:*",
    "@types/d3-geo": "^3.1.1",
    "d3-geo": "^3.1.1",
    "zod": "^3.23.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src test",
    "test": "vitest run",
    "playwright": "playwright test",
    "prepublishOnly": "pnpm build && pnpm typecheck && pnpm lint && pnpm test"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "src",
    "dist"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "devDependencies": {}
}
