{
  "name": "@knowledgeassemble/interactive-react",
  "version": "0.1.2",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@knowledgeassemble/interactive-engine": "workspace:*",
    "@knowledgeassemble/visual-engine": "workspace:*",
    "@knowledgeassemble/chart-engine": "workspace:*",
    "@knowledgeassemble/geomap-engine": "workspace:*",
    "@knowledgeassemble/timeline-engine": "workspace:*",
    "@knowledgeassemble/diagram-engine": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vitest": "^3.0.0",
    "jsdom": "^26.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src test",
    "test": "vitest run",
    "playwright": "playwright test",
    "prepublishOnly": "pnpm build && pnpm typecheck && pnpm lint && pnpm test"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./svg-surface": {
      "types": "./src/svg-surface.ts",
      "default": "./src/svg-surface.ts"
    }
  },
  "files": [
    "src",
    "dist"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./svg-surface": {
        "types": "./dist/svg-surface.d.ts",
        "default": "./dist/svg-surface.js"
      }
    }
  }
}
