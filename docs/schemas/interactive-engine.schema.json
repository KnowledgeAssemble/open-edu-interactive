{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openedu.org/schemas/interactive-engine.schema.json",
  "title": "OpenEdu Interactive Engine Specification",
  "description": "Base schema for semantic, data-driven, renderer-independent OpenEdu interactive engines.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "version",
    "id"
  ],
  "properties": {
    "type": {
      "type": "string",
      "description": "The semantic engine type. Concrete engine schemas should constrain this value.",
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "version": {
      "type": "string",
      "description": "Semantic version of the engine specification.",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "id": {
      "type": "string",
      "description": "Stable identifier for this engine instance within the lesson.",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-zA-Z][a-zA-Z0-9._-]*$"
    },
    "metadata": {
      "$ref": "#/$defs/metadata"
    },
    "purpose": {
      "$ref": "#/$defs/purpose"
    },
    "content": {
      "type": "object",
      "description": "Engine-specific semantic content. Concrete engine schemas should define its structure.",
      "additionalProperties": true
    },
    "layout": {
      "$ref": "#/$defs/layout"
    },
    "interaction": {
      "$ref": "#/$defs/interaction"
    },
    "questions": {
      "type": "array",
      "description": "Optional pedagogical questions or activities associated with the engine.",
      "items": {
        "$ref": "#/$defs/question"
      }
    },
    "accessibility": {
      "$ref": "#/$defs/accessibility"
    },
    "appearance": {
      "$ref": "#/$defs/appearance"
    },
    "state": {
      "$ref": "#/$defs/initialState"
    },
    "events": {
      "$ref": "#/$defs/events"
    },
    "completion": {
      "$ref": "#/$defs/completion"
    },
    "resources": {
      "type": "array",
      "description": "Resources referenced by the engine.",
      "items": {
        "$ref": "#/$defs/resource"
      }
    },
    "sources": {
      "type": "array",
      "description": "Sources and provenance information for engine content.",
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "capabilities": {
      "type": "array",
      "description": "Capabilities explicitly supported by this engine instance.",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*$"
      }
    }
  },
  "$defs": {
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "language": {
          "type": "string",
          "description": "BCP 47 language tag.",
          "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"
        },
        "locale": {
          "type": "string"
        },
        "tags": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "subject": {
          "type": "string"
        },
        "educationalLevel": {
          "type": "string"
        },
        "estimatedInteractionTime": {
          "type": "integer",
          "minimum": 0,
          "description": "Estimated interaction time in seconds."
        },
        "author": {
          "type": "string"
        }
      }
    },
    "purpose": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "learningObjective": {
          "type": "string",
          "minLength": 1
        },
        "interactionGoal": {
          "type": "string"
        },
        "reasoningMode": {
          "$ref": "#/$defs/reasoningMode"
        }
      },
      "required": [
        "learningObjective"
      ]
    },
    "reasoningMode": {
      "type": "string",
      "enum": [
        "identify",
        "compare",
        "sequence",
        "classify",
        "estimate",
        "explore",
        "predict",
        "explain",
        "analyze",
        "construct",
        "investigate"
      ]
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "auto",
            "fixed",
            "flow",
            "grid",
            "radial",
            "hierarchical",
            "custom"
          ]
        },
        "orientation": {
          "type": "string",
          "enum": [
            "horizontal",
            "vertical",
            "left-to-right",
            "right-to-left",
            "top-to-bottom",
            "bottom-to-top"
          ]
        },
        "alignment": {
          "type": "string",
          "enum": [
            "start",
            "center",
            "end",
            "stretch"
          ]
        },
        "spacing": {
          "type": "number",
          "minimum": 0
        },
        "padding": {
          "type": "number",
          "minimum": 0
        },
        "responsive": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "interaction": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "explore",
            "identify",
            "compare",
            "sequence",
            "classify",
            "predict",
            "construct",
            "investigate",
            "explain"
          ]
        },
        "actions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/actionType"
          }
        },
        "guided": {
          "$ref": "#/$defs/guidedInteraction"
        },
        "allowReset": {
          "type": "boolean",
          "default": true
        },
        "allowUndo": {
          "type": "boolean",
          "default": false
        },
        "allowRedo": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "actionType": {
      "type": "string",
      "description": "Semantic action from DESIGN D5. Renderer input (click, pointer, keyboard) is not valid here.",
      "enum": [
        "select",
        "deselect",
        "focus",
        "unfocus",
        "filter",
        "clear-filter",
        "open-annotation",
        "close-annotation",
        "answer",
        "compare",
        "toggle",
        "expand",
        "collapse",
        "zoom",
        "pan",
        "scrub",
        "jump-to",
        "play-pause",
        "step",
        "drag",
        "drop",
        "place",
        "move",
        "connect",
        "disconnect",
        "follow",
        "bearing",
        "reset"
      ]
    },
    "guidedInteraction": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        }
      },
      "required": [
        "enabled"
      ]
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "prompt"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "type": {
          "type": "string",
          "enum": [
            "identify",
            "compare",
            "sequence",
            "classify",
            "estimate",
            "predict",
            "explain",
            "analyze",
            "construct",
            "investigate"
          ]
        },
        "prompt": {
          "type": "string",
          "minLength": 1
        },
        "interaction": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "$ref": "#/$defs/actionType"
            }
          },
          "required": [
            "type"
          ]
        },
        "targets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reference"
          }
        },
        "feedback": {
          "$ref": "#/$defs/feedback"
        }
      }
    },
    "feedback": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "correct": {
          "type": "string"
        },
        "incorrect": {
          "type": "string"
        },
        "hint": {
          "type": "string"
        },
        "partiallyCorrect": {
          "type": "string"
        },
        "completed": {
          "type": "string"
        }
      }
    },
    "accessibility": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "keyboard": {
          "type": "boolean",
          "default": true
        },
        "reducedMotion": {
          "type": "boolean",
          "default": true
        },
        "alternativeRepresentation": {
          "type": "string"
        },
        "alternativeRepresentationType": {
          "type": "string",
          "enum": [
            "linear",
            "text",
            "table",
            "list",
            "structured"
          ]
        },
        "focusOrder": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "announcements": {
          "type": "boolean",
          "default": true
        }
      },
      "required": [
        "label"
      ]
    },
    "appearance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "theme": {
          "type": "string"
        },
        "density": {
          "type": "string",
          "enum": [
            "compact",
            "comfortable",
            "spacious"
          ]
        },
        "motion": {
          "$ref": "#/$defs/motion"
        }
      }
    },
    "motion": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "reducedMotionBehavior": {
          "type": "string",
          "enum": [
            "instant",
            "minimal",
            "disabled"
          ]
        }
      }
    },
    "initialState": {
      "type": "object",
      "description": "Initial engine state. Concrete engine schemas should define engine-specific state properties.",
      "additionalProperties": true
    },
    "events": {
      "type": "array",
      "description": "Semantic events that this engine can emit.",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/eventDefinition"
      }
    },
    "eventDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*)?$"
        },
        "description": {
          "type": "string"
        }
      }
    },
    "completion": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "conditions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/condition"
          }
        },
        "requireAll": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "selected",
            "focused",
            "highlighted",
            "completed",
            "connected",
            "placed",
            "state"
          ]
        },
        "target": {
          "$ref": "#/$defs/reference"
        },
        "state": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "type": {
          "type": "string",
          "enum": [
            "image",
            "audio",
            "video",
            "svg",
            "document",
            "data",
            "map",
            "other"
          ]
        },
        "src": {
          "type": "string"
        },
        "alt": {
          "type": "string"
        },
        "mimeType": {
          "type": "string"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "authoritative",
            "reference",
            "illustrative",
            "simulated",
            "learner-generated",
            "ai-generated"
          ]
        },
        "class": {
          "type": "string",
          "enum": [
            "authoritative",
            "illustrative",
            "simulated"
          ],
          "description": "Accuracy class per DESIGN \u00a79 (provenance)."
        },
        "title": {
          "type": "string"
        },
        "citation": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "author": {
          "type": "string"
        },
        "date": {
          "type": "string"
        }
      }
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "type": {
          "type": "string"
        },
        "engine": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        }
      }
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-zA-Z][a-zA-Z0-9._-]*$"
    }
  }
}
